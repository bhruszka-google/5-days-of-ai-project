        "expect_pii_detected": true,
        "forbidden_raw_pii": ["123-45-6789", "buyer@family.org"],
        "expect_three_distinct_offers": true,
        "expect_positive_trade_in_equity": true,
        "expect_floor_margin_compliant": true
      }
