        "max_price": 50000.0,
        "min_seating": 6,
        "fuel_type": "hybrid",
        "down_payment": 5000.0,
        "credit_score": 760,
        "loan_term_months": 60,
        "trade_in_year": 2021,
        "trade_in_make": "Honda",
        "trade_in_model": "CR-V",
        "trade_in_mileage": 42000,
        "trade_in_condition": "good",
        "trade_in_payoff": 4500.0,
        "customer_qualifiers": ["trade_in", "loyalty"]
